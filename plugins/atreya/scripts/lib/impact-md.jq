# impact-md.jq: impact.md body (the 12 headings of references/impact-template.md)
# from impact-facts.json with the analysis merged. The front matter comes from
# doc-stamp.sh (impact-render.sh prepends it). Run with -L scripts/lib -r.
include "impact-view";
def md: tostring | gsub("[\r\n]+"; " ") | gsub("<"; "&lt;") | gsub(">"; "&gt;");
def cell: md | gsub("\\|"; "\\|");
def cites($c): ($c // []) | map("`\(. | md)`") | join(", ");
def ev($e): if $e == null then "" else
  " [\($e.class)\(if (($e.cites // []) | length) > 0 then ": " + cites($e.cites) else "" end)\(if $e.note then " (\($e.note | md))" else "" end)\(if $e.assumption then ", \($e.assumption)" else "" end)]" end;
def stmt: if type == "object" then "\(.text | md)\(ev(.evidence))" else md end;
def list($x; f): if ($x | length) == 0 then "- None." else ($x | map("- " + (. | f)) | join("\n")) end;
def none_or($x; $s): if ($x | length) == 0 then "none" else $s end;
def nz($s): if ($s // "") == "" then "–" else $s end;

view as $V |
"# \($V.title | md): Impact analysis",
"",
"> Generated by `/atreya:impact` from `impact-facts.json` (scripts collect the facts; Claude writes the analysis). Status **Draft** until a human reviews it. Evidence classes: **Verified** (code at the stamped commit, `Repo:path:line`), **Inferred**, **Assumption**, **Unknown**, **Not affected**.",
"",
"## 1. Change",
"",
"- **Source**: \(if $V.input.source == "zoho" then "Zoho Sprints \($V.input.id | md)" else "free text" end)",
"- **Ticket**: `\($V.ticket)`",
"",
"> \(($V.input.text // "") | md)",
"",
"**What is asked**: \(($V.summary.headline // "") | md)",
"",
"### Requirement understanding",
"",
"**Current behaviour**", list($V.requirement.current // []; stmt), "",
"**Proposed behaviour**", list($V.requirement.proposed // []; stmt), "",
"**Business objective**: \(if $V.requirement.objective then ($V.requirement.objective | stmt) else "not stated (see §11)" end)", "",
"**Ambiguities**", list($V.requirement.ambiguities // []; "\(.text | md) (→ \(.question))"), "",
"**Missing requirements**", list($V.requirement.missing // []; "\(.text | md) (→ \(.question))"),
"",
"## 2. Summary",
"",
"- **Changed module(s)**: \(none_or($V.changed_modules; $V.changed_modules | join(", ")))",
"- **Direct modules**: \($V.counts.direct) · **Indirect modules**: \($V.counts.indirect) (depth limit \($V.depth_limit)) · **Investigated, not affected**: \($V.counts.not_affected)",
"- **Overall risk**: **\($V.risk.level)** (confidence \($V.risk.confidence)); script rules: \($V.risk.script_level)\(if ($V.risk.rules | length) > 0 then " (\($V.risk.rules | join(", ")))" else "" end)\(if ($V.risk.raised_by | length) > 0 then "; raised by \($V.risk.raised_by | join(", "))" else "" end)",
(if ($V.risk.why | length) > 0 then "- **Why this confidence**: \($V.risk.why | map(md) | join("; "))" else empty end),
"- **Unknowns**: \($V.counts.unknowns) · **Conflicting evidence**: \($V.counts.conflicts) · **Open questions**: \($V.counts.questions)",
"",
"**Key business consequences**", list($V.summary.consequences // []; stmt),
"",
"## 3. Affected modules",
"",
"### Direct",
list([$V.modules[] | select(.role == "direct")]; "**\(.id)** (\(.name | md))\(if .critical then ", critical" else "" end): \(.why | map(md) | join("; "))\(ev(.evidence))" +
  (if .notes then "\n  - \(nz(.notes.description) | md)\n  - Why affected: \(nz(.notes.why_affected) | md)" + ((.notes.functional_impact // []) | map("\n  - Functional impact: " + (. | stmt)) | join("")) else "" end)),
"",
"### Indirect",
(if ([$V.modules[] | select(.role == "indirect")] | length) == 0 then "None." else
  "| Module | Depth | Direction | Why (path of the dependency) | Evidence |\n|---|---|---|---|---|\n" +
  ([$V.modules[] | select(.role == "indirect") | "| **\(.id)**\(if .critical then " (critical)" else "" end) | \(.depth // "–") | \(.direction) | \(.why | map(cell) | join("<br>"))\(if .notes then "<br>" + (nz(.notes.why_affected) | cell) else "" end) | \(.evidence.class)\(if ((.evidence.cites // []) | length) > 0 then ": " + (.evidence.cites[0:4] | map("`\(cell)`") | join(", ")) else "" end) |"] | join("\n")) end),
"",
"### Investigated, not affected",
list($V.not_affected; "**\(.id)**: \(.reason | md) [\(.evidence.class)\(if .source == "analysis" then ", analysis" else "" end)]"),
"",
"### End-to-end workflow",
(if ($V.workflow | length) == 0 then "None described (see §11)." else
  "| Step | Actor | Module | Screen / route | Before | After | If it fails | Evidence |\n|---|---|---|---|---|---|---|---|\n" +
  ($V.workflow | map("| \(.step) | \(.actor | cell) | \(nz(.module) | cell) | \(nz([.screen, .route] | map(select(. != null and . != "")) | join(" · ")) | cell) | \(.before | cell) | \(.after | cell) | \(.on_failure | cell) | \(.evidence.class // "–") |") | join("\n")) end),
"",
"## 4. Code: files, routes & APIs",
"",
"### Backend routes changed",
list($V.backend_routes; "`\(.key)` → \(.controller | md) (`\(.source)`); middleware: \(none_or(.middleware // []; (.middleware // []) | join(", ")))" +
  (if (.callers | length) == 0 then "\n  - no client in this workspace calls it" else (.callers | map("\n  - called by \(.client) \(.caller | md) (`\(.source)`); pages: \(none_or(.pages; .pages | join(", ")))") | join("")) end)),
"",
"### Web routes changed", list($V.web_routes; "`\(.repo) \(.key)` → \(.controller | md) (`\(.source)`)"),
"",
"### API calls from changed client code", list($V.client_calls; "\(.client) \(.caller | md) → `\(.route // "unresolved")` (\(.module // "?")) at `\(.source)`"),
"",
"### Changed and affected code (controllers, services, listeners)",
(if ($V.code | length) == 0 then "None." else
  "| Role | Method | Kind | Module | Reads | Writes | Uses | Transaction | Source |\n|---|---|---|---|---|---|---|---|---|\n" +
  ($V.code | map("| \(.role) | \(.method | cell) | \(.kind) | \(.module // "–") | \(none_or(.reads; .reads | join(", "))) | \(none_or(.writes; [.writes[].table] | unique | join(", "))) | \(none_or(.uses; [.uses[].class | short] | join(", "))) | \(if .transaction then "yes" else "no" end) | `\(.cite)` |") | join("\n")) end),
"",
"### Events", list($V.events; "\(.event | short) emitted at `\(.emitted_at)` → \(if (.listeners | length) == 0 then "no mapped listener" else ([.listeners[] | "\(.class | short) (\(.module // "no module"))"] | join(", ")) end)"),
"",
"### Cycles and depth limit",
list([($V.cycles[] | "cycle: " + (.path | map(sub("^[a-z-]+:"; "")) | join(" → ") | md)), ($V.truncated[] | "beyond the depth limit: \(.label | md) (\(.module // "no module"), depth \(.depth))")]; .),
"",
"## 5. Screens (web / mobile)",
"",
"### Changed", list($V.screens.changed; "\(.repo):\(.id) (`\(.repo):\(.file)`)"),
"### Web pages to check", list($V.screens.web_pages; md),
"### App screens affected", list($V.screens.app_screens; md),
"",
"## 6. Data",
"",
"### Tables",
"**Changed**", list($V.tables.changed; "`\(.name)` used by: \(none_or(.modules; .modules | join(", ")))"),
"**Read by changed routes (context)**", list($V.tables.read; "`\(.name)` (\(.modules) modules)"),
"",
"### Data flow",
(if ($V.data_flow | length) == 0 then "None." else
  "| Operation | Table | Where | Other modules reading it | Evidence |\n|---|---|---|---|---|\n" +
  ($V.data_flow | map("| \(.op) | \(.table) | `\(.cite)` | \(none_or(.consumers; (.consumers | length | tostring) + ": " + (.consumers[0:8] | join(", ")) + (if (.consumers | length) > 8 then ", …" else "" end))) | \(.evidence.class) |") | join("\n")) end),
"",
"### Data fields and calculations",
list($V.data_fields; "`\(.table // "?")`.\(.field // "?" | md): \(.change | md)\(if .calculation then "; calculation: \(.calculation | md)" else "" end)\(ev(.evidence))"),
"",
"### Data-consistency and financial risks",
list([($V.data_risks[] | "\(.id) **\(.level)** [\(.rule)] \(.reason | md). \(.consequence | md)"), ($V.data_consistency[] | "\(.text | md). \(.consequence // "" | md)\(if .risk then " (\(.risk))" else "" end)\(ev(.evidence))")]; .),
"",
"## 7. External systems",
"",
list($V.external_systems; "\(.system | md): `\(.where)`"),
"",
"## 8. Docs & diagrams to update",
"",
list($V.docs; "\(.doc): \(.where | map(md) | join(", "))"),
"",
"### Traceability",
list($V.traceability; "\(.ref)\(if .doc then " (\(.doc))" else "" end)\(if .note then ": \(.note | md)" else "" end)"),
"",
"## 9. Risk",
"",
"**Overall: \($V.risk.level)** (confidence \($V.risk.confidence)). Script rules give \($V.risk.script_level)\(if ($V.risk.raised_by | length) > 0 then "; the analysis raises it (\($V.risk.raised_by | join(", ")))" else "" end). v1 rule level: \($V.risk.v1_level). Rules: `references/impact-risk-rules.md`.",
"",
(if ($V.risks | length) == 0 then "No risk rule matched." else
  "| ID | Level | Rule | Reason | Consequence | Evidence | Confidence | Source |\n|---|---|---|---|---|---|---|---|\n" +
  ($V.risks | map("| \(.id) | \(.level) | \(.rule) | \(.reason | cell) | \(.consequence | cell) | \(.evidence.class)\(if ((.evidence.cites // []) | length) > 0 then ": " + (.evidence.cites[0:3] | map("`\(cell)`") | join(", ")) else "" end) | \(.confidence) | \(.source) |") | join("\n")) end),
"",
"## 10. QA to rerun",
"",
"Web staging only (`references/qa-scope-rules.md`). No scenario below has been executed by this analysis.",
"",
"- Sanity: \(none_or($V.qa_v1.sanity; $V.qa_v1.sanity | join(", ")))",
"- Regression: \(none_or($V.qa_v1.regression; $V.qa_v1.regression | join(", ")))",
"- Not covered by QA: \(none_or($V.qa_v1.not_covered; $V.qa_v1.not_covered | map(md) | join("; ")))",
"",
"### Scope by module",
list($V.qa_groups;
  "**\(.id)** (\(.role)): pages \(none_or(.pages; .pages | join(", "))); app screens \(none_or(.app_screens; .app_screens | join(", "))); scenarios \(none_or(.scenario_ids; .scenario_ids | join(", ")))"),
"",
"### Scenarios",
(if ($V.qa_scenarios | length) == 0 then "None written (see §11)." else
  "| ID | Module | Step | Type | Origin | Scenario | Expected | Trace | Status |\n|---|---|---|---|---|---|---|---|---|\n" +
  ($V.qa_scenarios | map("| \(.id) | \(nz(.module)) | \(.step // "–") | \(.type) | \(.origin) | \(.title | cell) | \(.expected | cell) | \(none_or(.trace // []; .trace | join(", "))) | \(.status) |") | join("\n")) end),
"",
"### Existing tests and acceptance criteria",
list($V.qa_existing; "\(.ref): \(.kind) (\(.source))"),
"",
"## 11. Needs confirmation",
"",
"### Open questions",
list($V.open_questions; "**\(.id)** (\(.role)): \(.question | md)\(if ((.blocks // []) | length) > 0 then " — affects \(.blocks | join(", "))" else "" end)"),
"",
"### Assumptions",
list($V.assumptions; "**\(.id)**: \(.text | md)\(if ((.affects // []) | length) > 0 then " — affects \(.affects | join(", "))" else "" end)"),
"",
"### Unknowns",
list($V.unknowns; "\(.what | md): \(.why | md) (\(.where | md))"),
"",
"### Conflicting evidence",
list($V.conflicts; "\(.what | md): \(.effect | md) (\(.sources | map(md) | join("; ")))"),
"",
"### Recommended actions",
list($V.actions; "(\(.role)) \(.text | md)"),
"",
"## 12. Document control",
"",
"- Status: **Draft**. Only a human moves it to Reviewed or Approved.",
"- Reviewer: \($V.reviewer)",
"- Built from `impact-facts.json` (facts sha256 \($V.sha[0:12])); HTML report: `impact-report.html` (same data).",
(if ($V.map_behind | length) > 0 then "- Warning: `_map` is behind HEAD: \($V.map_behind | map(md) | join("; "))" else empty end),
"- Checks: `checks/impact-check.md` (check-doc.sh, impact-check.sh and the doc-checker agent)."
